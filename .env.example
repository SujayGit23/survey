# ==============================================================================
# KOLABA SURVEY PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# 1. EMAIL NOTIFICATION CONFIGURATION
# All survey responses are automatically formatted and emailed to RECIPIENT_EMAIL.
RECIPIENT_EMAIL=aditidas2486@gmail.com
SURVEY_NOTIFICATION_EMAIL=aditidas2486@gmail.com

# --- OPTION A: Direct Gmail / SMTP Delivery (Recommended) ---
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-character-gmail-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# --- OPTION B: Transactional Email via Resend (Alternative) ---
RESEND_API_KEY=re_your_api_key_here

# 2. SUPABASE CONFIGURATION (Optional - responses also save to local JSON storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 3. APP BASE URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
